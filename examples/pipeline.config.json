{
  "permission": {
    "web": "deny",
    "mcp_write": "deny",
    "run": {
      "*": "deny",

      "cargo *": "allow",
      "go *": "allow",
      "gofmt *": "allow",
      "python3 *": "allow",
      "bash *": "allow",
      "sh *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "echo *": "allow",
      "true": "allow",

      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git ls-files *": "allow",
      "git blame *": "allow",
      "git rev-parse *": "allow",

      "stage/stage.sh check *": "allow",
      "stage/stage.sh logs *": "allow",
      "stage/stage.sh status *": "allow",
      "bash stage/stage.sh check *": "allow",
      "bash stage/stage.sh logs *": "allow",
      "bash stage/stage.sh status *": "allow",

      "git commit *": "deny",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git checkout -- *": "deny",
      "git remote *": "deny",
      "git config *": "deny",
      "git am *": "deny",
      "git rebase *": "deny",
      "git cherry-pick *": "deny",
      "git tag *": "deny",
      "git stash *": "deny",
      "git branch *": "deny",
      "git update-ref *": "deny",

      "bash -c *": "deny",
      "sh -c *": "deny",
      "python3 -c *": "deny",

      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "deny",
      "scancel *": "deny",
      "squeue *": "deny",
      "sbatch *": "deny",
      "srun *": "deny",
      "berserk-ctl.sh *": "deny",
      "bsk gw *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "nc *": "deny",
      "docker *": "deny",
      "systemctl *": "deny",
      "kill *": "deny",
      "pkill *": "deny",
      "sudo *": "deny",

      "ssh * stage/stage.sh check *": "allow",
      "ssh * stage/stage.sh logs *": "allow",
      "ssh * stage/stage.sh status *": "allow"
    }
  }
}
